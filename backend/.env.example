# Server
PORT=8000
NODE_ENV=development
REACT_APP_URL=http://localhost:5173

# Auth (required for Google OAuth + JWT)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALL_BACK_URL=http://localhost:8000/auth/google/callback
COOKIE_KEY=
JWT_TOKEN_KEY=
REFRESH_TOKEN_KEY=
# MongoDB Atlas (add database name in path, e.g. /notebooklm)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/notebooklm?retryWrites=true&w=majority

# RAG / pipelines (optional for drive auth MVP)
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
TAVILY_API_KEY=

# Notes (title + image generation)
FIRE_WORKS_API_KEY=
# Optional: custom Fireworks workflow URL for image generation
# FIREWORKS_IMAGE_WORKFLOW_URL=
