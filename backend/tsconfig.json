{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "outDir": "dist",
      "rootDir": "src",
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "ts-node": {
      "require": ["tsconfig-paths/register"]
    },
    "include": ["src"],
    "exclude": ["node_modules"]
  }