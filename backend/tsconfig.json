{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "baseUrl": ".",
      "ignoreDeprecations": "6.0",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "ts-node": {
      "require": ["tsconfig-paths/register"]
    },
    "include": ["src", "scripts"],
    "exclude": ["node_modules", "dist"]
  }