{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2022",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "outDir": "dist",
      "rootDir": "src",
      "paths": {
        "@/*": ["./src/*"]
      },
  
    },
    "include": ["src",],
    "exclude": ["node_modules"]
  }